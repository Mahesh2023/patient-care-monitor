# Local dev config for CARE-MM. LLM disabled by default; the pipeline
# runs fine without it. Set GROQ_API_KEY and ENABLE_LLM_REASONING=true
# to enable the hedged clinical-summary sentence.
LLM_PROVIDER=none
ENABLE_LLM_REASONING=false
GROQ_API_KEY=

TARGET_FPS=10
MAX_FPS_PER_SESSION=15
SESSION_TIMEOUT_SECONDS=300

PSPI_MILD_THRESHOLD=1.5
PSPI_MODERATE_THRESHOLD=4.0
PSPI_SEVERE_THRESHOLD=8.0
ALERT_COOLDOWN_SECONDS=30.0
ALERT_CONSECUTIVE_FRAMES=5

CONSENT_TTL_HOURS=24
STORE_RAW_FRAMES=false

LOG_LEVEL=INFO
ENABLE_PROMETHEUS=true
