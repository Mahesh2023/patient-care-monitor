# Copy to .env for local development. Production values are set by render.yaml.
ENVIRONMENT=development
# Local default is SQLite; for Postgres: postgresql://user:pass@localhost:5432/care_mm
DATABASE_URL=sqlite+aiosqlite:///./care_mm.db
# Leave empty for single-process in-memory fallback; e.g. redis://localhost:6379/0
REDIS_URL=
# Required in production (>= 32 chars). Empty in dev => ephemeral random secret.
JWT_SECRET=
# Must be false when serving over plain http://localhost
COOKIE_SECURE=false
# AES-GCM key material for secrets at rest (TOTP). Required (>= 32 chars) in production.
DATA_ENCRYPTION_KEY=
# Account protection
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=900
HIBP_ENABLED=true
AUDIT_RETENTION_DAYS=2190

# Clinical
BASELINE_SECONDS=20
ALERT_ESCALATION_URGENT_MINUTES=5
ALERT_ESCALATION_CONCERN_MINUTES=15

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
ENABLE_LLM_REASONING=true
LLM_COOLDOWN_SECONDS=30

TARGET_FPS=10
CONSENT_TTL_HOURS=24
METRICS_RETENTION_DAYS=30
ALERTS_RETENTION_DAYS=365

PSPI_MILD_THRESHOLD=1.5
PSPI_MODERATE_THRESHOLD=4.0
PSPI_SEVERE_THRESHOLD=8.0
ALERT_COOLDOWN_SECONDS=30.0
ALERT_CONSECUTIVE_FRAMES=5

LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_PROMETHEUS=true
METRICS_TOKEN=
